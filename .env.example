# Copy this file to .env on the cPanel server and fill in the real values.
# Never commit the real .env file.
#
# VITE_* values are required at BUILD time for the browser bundle.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Server-side runtime values.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Only required if server-side admin operations are enabled.
# Keep this secret and server-side only.
SUPABASE_SERVICE_ROLE_KEY=
